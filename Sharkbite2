local espConnections = {}
local espWatching = false

local function setSharkESP(enabled)
    for _, conn in ipairs(espConnections) do
        conn:Disconnect()
    end
    table.clear(espConnections)
    espWatching = false

    for _, desc in ipairs(sharksFolder:GetDescendants()) do
        if desc:IsA("Highlight") then
            desc.Enabled = enabled
            desc.OutlineTransparency = enabled and 0 or 1
            if enabled then
                table.insert(espConnections, desc:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if not desc.Enabled then desc.Enabled = true end
                end))
                table.insert(espConnections, desc:GetPropertyChangedSignal("OutlineTransparency"):Connect(function()
                    if desc.OutlineTransparency ~= 0 then desc.OutlineTransparency = 0 end
                end))
            end
        end
    end

    if enabled and not espWatching then
        espWatching = true
        table.insert(espConnections, sharksFolder.DescendantAdded:Connect(function(desc)
            if desc:IsA("Highlight") then
                desc.Enabled = true
                desc.OutlineTransparency = 0
                table.insert(espConnections, desc:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if not desc.Enabled then desc.Enabled = true end
                end))
                table.insert(espConnections, desc:GetPropertyChangedSignal("OutlineTransparency"):Connect(function()
                    if desc.OutlineTransparency ~= 0 then desc.OutlineTransparency = 0 end
                end))
            end
        end))
    end
end

